pipeline {
    agent any

    stages {
        stage('Clean Environment') {
            steps {
                script {
                    echo 'Cleaning up existing backend and frontend containers...'
                    sh '''
                    docker-compose -p taskflow stop backend frontend || true
                    docker-compose -p taskflow rm -f backend frontend || true
                    docker network prune -f || true
                    '''
                }
            }
        }

        stage('Ensure Mongo is Running') {
            steps {
                script {
                    echo 'Ensuring Mongo container is running...'
                    sh '''
                    if ! docker ps | grep -q taskflow-mongo; then
                        docker start -p taskflow taskflow-mongo || docker-compose -p taskflow up -d mongo
                    fi
                    '''
                }
            }
        }

        stage('Build Images') {
            steps {
                script {
                    echo 'Rebuilding backend and frontend images...'
                    sh '''
                    docker-compose build backend frontend
                    '''
                }
            }
        }


        stage('Build Project') {
            steps {
                script {
                    echo 'Building the project...'
                    sh '''
                    cd taskflow-backend
                    ../mvnw clean install -DskipTests || exit 1
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    echo 'Running SonarQube analysis...'
                    withSonarQubeEnv('SonarQube Server') {
                        withCredentials([string(credentialsId: '98a4191f-2183-4e5f-9cb8-86a4c26bef24', variable: 'SONAR_TOKEN')]) {
                            sh '''
                            cd taskflow-backend
                            ../mvnw sonar:sonar \
                                -Dsonar.projectKey=taskflow-backend \
                                -Dsonar.host.url=http://taskflow-sonarqube:9000 \
                                -Dsonar.login=$SONAR_TOKEN \
                                -Dsonar.java.binaries=target/classes || exit 1
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo 'Starting only backend and frontend containers...'
                    sh '''
                    docker-compose -p taskflow up -d --no-deps frontend backend
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                echo 'Pipeline completed. No unnecessary services touched.'
            }
        }
        failure {
            script {
                echo 'Pipeline failed. Check logs for more details.'
            }
        }
    }
}