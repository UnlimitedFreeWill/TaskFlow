pipeline {
    agent any

    stages {
        stage('Clean Environment') {
            steps {
                script {
                    echo 'Stopping and removing only frontend and backend containers...'
                    sh '''
                    docker-compose stop backend frontend || true
                    docker-compose rm -f backend frontend || true
                    docker ps -a --filter "name=taskflow-backend" --filter "name=taskflow-frontend" -q | xargs -r docker rm -f || true
                    '''
                }
            }
        }

        stage('Build Backend') {
            steps {
                script {
                    echo 'Building backend image...'
                    sh '''
                    docker build -t taskflow-backend ./taskflow-backend
                    '''
                }
            }
        }

        stage('Build Frontend') {
            steps {
                script {
                    echo 'Building frontend image...'
                    sh '''
                    docker build -t taskflow-frontend ./taskflow-frontend
                    '''
                }
            }
        }

        stage('Ensure Mongo is Running') {
        steps {
            script {
                sh '''
                if ! docker ps | grep -q taskflow-mongo; then
                    docker-compose up -d mongo
                fi
                '''
            }
        }
    }

        stage('Deploy') {
            steps {
                script {
                    echo 'Starting only backend and frontend containers...'
                    sh '''
                    docker-compose up -d --no-deps frontend backend
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                echo 'Pipeline completed. No unnecessary services touched.'
            }
        }
        failure {
            script {
                echo 'Pipeline failed. Check logs for more details.'
            }
        }
    }
}