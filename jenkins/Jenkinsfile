pipeline {
    agent any

    stages {
        stage('Clean Environment') {
            steps {
                script {
                    echo 'Stopping and removing only frontend and backend containers...'
                    sh '''
                    docker-compose stop backend frontend || true
                    docker-compose rm -f backend frontend || true
                    '''
                }
            }
        }

        stage('Build Backend') {
            steps {
                script {
                    echo 'Building backend image...'
                    sh '''
                    docker build -t taskflow-backend ./taskflow-backend
                    '''
                }
            }
        }

        stage('Build Frontend') {
            steps {
                script {
                    echo 'Building frontend image...'
                    sh '''
                    docker build -t taskflow-frontend ./taskflow-frontend
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    echo 'Running tests (currently skipped)...'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    echo 'Running SonarQube analysis...'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo 'Starting backend and frontend containers...'
                    sh '''
                    docker-compose up -d backend frontend
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                echo 'Pipeline completed. Resources cleaned for frontend and backend.'
            }
        }
        failure {
            script {
                echo 'Pipeline failed. Check logs for more details.'
            }
        }
    }
}